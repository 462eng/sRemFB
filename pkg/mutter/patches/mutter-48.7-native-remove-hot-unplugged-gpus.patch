Index: mutter-48.7/src/backends/meta-backend.c
===================================================================
--- mutter-48.7.orig/src/backends/meta-backend.c
+++ mutter-48.7/src/backends/meta-backend.c
@@ -1952,6 +1952,25 @@ meta_backend_add_gpu (MetaBackend *backe
   g_signal_emit (backend, signals[GPU_ADDED], 0, gpu);
 }
 
+/*
+ * Drops the backend's reference on @gpu and forgets it. The caller is
+ * expected to keep its own reference for as long as other components
+ * (e.g. the renderer) may still use the GPU.
+ */
+void
+meta_backend_remove_gpu (MetaBackend *backend,
+                         MetaGpu     *gpu)
+{
+  MetaBackendPrivate *priv = meta_backend_get_instance_private (backend);
+  GList *link;
+
+  link = g_list_find (priv->gpus, gpu);
+  g_return_if_fail (link);
+
+  priv->gpus = g_list_delete_link (priv->gpus, link);
+  g_object_unref (gpu);
+}
+
 GList *
 meta_backend_get_gpus (MetaBackend *backend)
 {
