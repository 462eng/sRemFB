+static gpointer
+remove_device_in_impl (MetaThreadImpl  *thread_impl,
+                       gpointer         user_data,
+                       GError         **error)
+{
+  MetaKmsDevice *device = user_data;
+  MetaKms *kms = meta_kms_device_get_kms (device);
+
+  /* kms->devices is iterated in the impl context, so only modify it while
+   * the main thread is blocked waiting for this task. */
+  kms->devices = g_list_remove (kms->devices, device);
+  meta_kms_device_mark_removed_in_impl (device);
+
+  return GINT_TO_POINTER (TRUE);
+}
+
+/*
+ * Forget a device whose DRM node was hot unplugged. The device is removed
+ * from the device list, its impl device is closed and marked as removed so it
+ * never reopens its (possibly reused) path, and MetaKms::device-removed is
+ * emitted. The list reference is dropped; callers that still use the device
+ * must hold their own reference.
+ */
+void
+meta_kms_remove_device (MetaKms       *kms,
+                        MetaKmsDevice *device)
+{
+  g_return_if_fail (g_list_find (kms->devices, device));
+
+  meta_kms_run_impl_task_sync (kms, remove_device_in_impl, device, NULL);
+
+  g_signal_emit (kms, signals[DEVICE_REMOVED], 0, device);
+
+  g_object_unref (device);
+}
