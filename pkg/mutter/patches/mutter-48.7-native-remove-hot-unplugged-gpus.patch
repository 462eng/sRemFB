 static gboolean
+release_removed_gpus (gpointer user_data)
+{
+  MetaBackendNative *native = META_BACKEND_NATIVE (user_data);
+  MetaBackendNativePrivate *priv =
+    meta_backend_native_get_instance_private (native);
+  MetaRenderer *renderer = meta_backend_get_renderer (META_BACKEND (native));
+  GList *l;
+
+  l = priv->removed_gpus;
+  while (l)
+    {
+      RemovedGpu *removed_gpu = l->data;
+      GList *l_next = l->next;
+
+      if (meta_renderer_native_release_gpu (META_RENDERER_NATIVE (renderer),
+                                            removed_gpu->gpu_kms))
+        {
+          meta_topic (META_DEBUG_BACKEND, "Released removed gpu '%s'",
+                      meta_kms_device_get_path (removed_gpu->kms_device));
+          priv->removed_gpus = g_list_delete_link (priv->removed_gpus, l);
+          removed_gpu_free (removed_gpu);
+        }
+
+      l = l_next;
+    }
+
+  if (priv->removed_gpus)
+    return G_SOURCE_CONTINUE;
+
+  priv->release_removed_gpus_id = 0;
+  return G_SOURCE_REMOVE;
+}
+
+static void
+on_udev_device_removed (MetaUdev          *udev,
+                        GUdevDevice       *device,
+                        MetaBackendNative *native)
+{
+  MetaBackendNativePrivate *priv =
+    meta_backend_native_get_instance_private (native);
+  MetaBackend *backend = META_BACKEND (native);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaRenderer *renderer = meta_backend_get_renderer (backend);
+  MetaGpuKms *gpu_kms = NULL;
+  RemovedGpu *removed_gpu;
+  const char *device_path;
+  gboolean had_outputs;
+  GList *l;
+
+  if (g_udev_device_get_device_type (device) != G_UDEV_DEVICE_TYPE_CHAR ||
+      g_strcmp0 (g_udev_device_get_property (device, "DEVTYPE"),
+                 "drm_minor") != 0)
+    return;
+
+  device_path = g_udev_device_get_device_file (device);
+
+  for (l = meta_backend_get_gpus (backend); l; l = l->next)
+    {
+      if (!g_strcmp0 (device_path, meta_gpu_kms_get_file_path (l->data)))
+        {
+          gpu_kms = l->data;
+          break;
+        }
+    }
+
+  if (!gpu_kms)
+    return;
+
+  if (!renderer || !monitor_manager)
+    return;
+
+  if (gpu_kms ==
+      meta_renderer_native_get_primary_gpu (META_RENDERER_NATIVE (renderer)))
+    {
+      g_warning ("Primary gpu '%s' was removed, this is not supported",
+                 device_path);
+      return;
+    }
+
+  g_message ("Removing gpu '%s'", device_path);
+
+  /* MetaKms already handled the removal as a hotplug event (see
+   * on_udev_device_removed() in meta-kms.c, connected before this handler),
+   * so the device has no CRTCs or connectors left and the monitor
+   * configuration no longer uses it. What is left is forgetting the device
+   * so that a new device reusing the same /dev/dri/cardN path is not
+   * rejected as "already present", and so that the DRM fd handed out to
+   * Wayland clients (DRM lease) gets closed. */
+  removed_gpu = g_new0 (RemovedGpu, 1);
+  removed_gpu->gpu_kms = g_object_ref (gpu_kms);
+  removed_gpu->kms_device = g_object_ref (meta_gpu_kms_get_kms_device (gpu_kms));
+
+  had_outputs = meta_gpu_get_outputs (META_GPU (gpu_kms)) != NULL;
+
+  meta_backend_remove_gpu (backend, META_GPU (gpu_kms));
+  meta_kms_remove_device (priv->kms, removed_gpu->kms_device);
+
+  if (had_outputs)
+    meta_monitor_manager_reload (monitor_manager);
+
+  priv->removed_gpus = g_list_append (priv->removed_gpus, removed_gpu);
+
+  /* The renderer may still reference the GPU from onscreens that are being
+   * torn down; release it once they are gone. */
+  if (!priv->release_removed_gpus_id)
+    {
+      priv->release_removed_gpus_id =
+        g_timeout_add_seconds (1, release_removed_gpus, native);
+    }
+}
+
+static gboolean
 init_gpus (MetaBackendNative  *native,
            GError            **error)
 {
@@ -722,6 +857,11 @@ init_gpus (MetaBackendNative  *native,
                            G_CALLBACK (on_udev_device_added),
                            native,
                            G_CONNECT_DEFAULT);
+  /* Must be connected after MetaKms's own "device-removed" handler. */
+  g_signal_connect_object (udev, "device-removed",
+                           G_CALLBACK (on_udev_device_removed),
+                           native,
+                           G_CONNECT_DEFAULT);
 
   return TRUE;
 }
