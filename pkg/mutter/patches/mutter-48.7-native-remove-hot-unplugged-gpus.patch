+/*
+ * Tries to release everything the renderer holds for @gpu_kms, which must no
+ * longer be part of the backend's GPU list. Returns TRUE when the renderer no
+ * longer references @gpu_kms (or its MetaKmsDevice) and it can be freed.
+ */
+gboolean
+meta_renderer_native_release_gpu (MetaRendererNative *renderer_native,
+                                  MetaGpuKms         *gpu_kms)
+{
+  MetaKmsDevice *kms_device = meta_gpu_kms_get_kms_device (gpu_kms);
+
+  g_return_val_if_fail (gpu_kms != renderer_native->primary_gpu_kms, FALSE);
+
+  /* Queued mode set updates are keyed by the (unreferenced) KMS device. */
+  if (g_hash_table_contains (renderer_native->mode_set_updates, kms_device))
+    return FALSE;
+
+  if (!g_hash_table_contains (renderer_native->gpu_datas, gpu_kms))
+    return TRUE;
+
+  /* Detached onscreens may still use the GPU data; they are only tracked
+   * once moved to the lingering list after the next mode set. */
+  if (renderer_native->detached_onscreens)
+    return FALSE;
+
+  free_unused_gpu_datas (renderer_native);
+
+  return !g_hash_table_contains (renderer_native->gpu_datas, gpu_kms);
+}
